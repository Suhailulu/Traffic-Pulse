# ==============================================================================
# TrafficPulse - Environment Configuration Template (.env.example)
# Copy this file to .env and adjust variables to match your local setup.
# ==============================================================================

# Application & Execution Mode
APP_ENV=development
APP_PORT=8501
LOG_LEVEL=INFO

# Local Storage Paths
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
DATA_SAMPLE_DIR=./data/sample
GEO_DATA_DIR=./data/geo
MODEL_REGISTRY_DIR=./src/prediction/models

# Big Data Infrastructure Configuration
# Mode options: 'docker' (connects to containerized HDFS/Hive) or 'local' (standalone execution)
BIGDATA_EXECUTION_MODE=local

# Hadoop HDFS Endpoints
HDFS_NAMENODE_URL=http://localhost:9870
HDFS_DEFAULT_FS=hdfs://localhost:9000
HDFS_RAW_PATH=/trafficpulse/raw
HDFS_PROCESSED_PATH=/trafficpulse/processed

# Apache Hive Endpoints
HIVE_SERVER_HOST=localhost
HIVE_SERVER_PORT=10000
HIVE_DATABASE=trafficpulse_db

# PySpark Execution Settings
SPARK_MASTER=local[*]
SPARK_APP_NAME=TrafficPulse_Analytics
SPARK_DRIVER_MEMORY=4g
SPARK_EXECUTOR_MEMORY=4g

# Machine Learning & Analytics Parameters
RANDOM_SEED=42
CONGESTION_SPEED_THRESHOLD_MPH=12.0
FREE_FLOW_BASELINE_HOUR_START=2
FREE_FLOW_BASELINE_HOUR_END=4
